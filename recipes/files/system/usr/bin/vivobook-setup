#!/usr/bin/env bash
# Configuração pessoal do Vivobook — rode uma vez após o rebase.
set -uo pipefail

RULE=/etc/udev/rules.d/99-asus-charge-limit.rules

echo "=== 1/3 Limite de carga da bateria ==="
read -rp "Limite em % (20-100) [80]: " lim
lim=${lim:-80}
if [[ "$lim" =~ ^[0-9]+$ ]] && (( lim >= 20 && lim <= 100 )); then
  sudo sed -i "s/echo [0-9]\+ >/echo $lim >/" "$RULE"
  echo "$lim" | sudo tee /sys/class/power_supply/BAT*/charge_control_end_threshold >/dev/null \
    && echo "OK: limite em $lim%." \
    || echo "Aviso: não consegui aplicar agora (vale no próximo boot)."
else
  echo "Valor inválido, pulando."
fi

echo
echo "=== 2/3 Aceleração de vídeo ==="
if vainfo 2>/dev/null | grep -qi "iHD"; then
  echo "OK: driver iHD (intel-media-driver) ativo."
else
  echo "Aviso: driver iHD não detectado. Rode 'vainfo' para ver o erro."
fi

echo
echo "=== 3/3 Reconhecimento facial (Biopass) ==="
echo "Câmeras encontradas (a IR costuma ter 'IR' no nome):"
v4l2-ctl --list-devices 2>/dev/null || cat /sys/class/video4linux/*/name
echo
echo "Abra o Biopass pelo menu de aplicativos para cadastrar o rosto"
echo "e escolher a câmera IR. Depois teste com: sudo -k && sudo echo funcionou"

echo
echo "Pronto."
